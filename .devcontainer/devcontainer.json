{
  "name": "LearnPath COME 491 Full-Stack Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && cd frontend && npm ci",
  "postStartCommand": "python3 .devcontainer/start_codespace.py",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "LearnPath Web App (React)",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "LearnPath FastAPI Docs (/docs)",
      "onAutoForward": "silent"
    }
  }
}
