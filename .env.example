# Root .env.example template (RAD v2.0 aligned)
POSTGRES_USER=learnpath
POSTGRES_PASSWORD=learnpath_dev_pass
POSTGRES_DB=learnpath_db
POSTGRES_PORT=5432

# IMPORTANT: Psycopg 3 driver requires the '+psycopg' scheme prefix in SQLAlchemy 2.0!
DATABASE_URL=postgresql+psycopg://learnpath:learnpath_dev_pass@localhost:5432/learnpath_db
TEST_DATABASE_URL=postgresql+psycopg://learnpath:learnpath_dev_pass@localhost:5432/learnpath_test

JWT_SECRET_KEY=change-this-in-local-env-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TEST_SESSION_EXPIRE_MINUTES=120
MASTERY_THRESHOLD_PERCENT=70.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

VITE_API_BASE_URL=http://localhost:8000/api/v1
